<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla_Ranking (ranking-screen, tarea 8.1).

  - Encabezado "Ranking Global" con icono de trofeo y subtítulo fijo con la
    nota "local/demo".
  - Tarjeta de podio con tres bloques: 2.º (izq), 1.º (centro, elevado y
    destacado con borde dorado) y 3.º (der); cada bloque con avatar, nombre,
    puntos y número de posición.
  - ChipGroup (singleSelection) de periodo: Semanal (por defecto) / Mensual /
    Total.
  - RecyclerView (recycler_ranking) para la lista de posiciones, ProgressBar de
    carga (progress_loading), estado vacío (empty_view) y contenedor de error
    (error_view) con reintentar.
  - Fondo con la paleta oscura azul del proyecto (blue_dark).

  Los IDs son estables para que RankingFragment (tarea 8.3) los enlace.
  Requisitos: 1.1, 2.4, 3.1, 3.2, 4.1
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_dark"
    android:orientation="vertical"
    tools:context=".RankingFragment">

    <!-- Encabezado: trofeo + "Ranking Global" + subtítulo local/demo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_trophy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/cd_ranking_trofeo"
                android:src="@drawable/ic_trophy" />

            <TextView
                android:id="@+id/text_ranking_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ranking_titulo"
                android:textColor="@color/text_white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Botón de historial: abre la misma pantalla que la confirmación de
                 pronóstico (HistorialPronosticosActivity). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ranking_historial"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/confirmacion_ver_historial"
                android:textColor="@color/text_white"
                app:icon="@drawable/ic_history"
                app:iconTint="@color/text_white" />

        </LinearLayout>

        <!-- Subtítulo fijo con la nota local/demo (R2.4) -->
        <TextView
            android:id="@+id/text_ranking_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ranking_subtitulo_demo"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Tarjeta de podio: 2.º (izq) | 1.º (centro, elevado/destacado) | 3.º (der) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_match_card"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Bloque 2.º puesto (izquierda) -->
        <LinearLayout
            android:id="@+id/podium_second"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_podium_block"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_podium_position_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ranking_posicion_2"
                android:textColor="@color/text_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_podium_avatar_2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/cd_ranking_avatar"
                android:src="@drawable/ic_avatar_placeholder" />

            <TextView
                android:id="@+id/text_podium_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                tools:text="CarlosGol" />

            <TextView
                android:id="@+id/text_podium_points_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/blue_end"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="2,980 pts" />

        </LinearLayout>

        <!-- Bloque 1.º puesto (centro, elevado y destacado) -->
        <LinearLayout
            android:id="@+id/podium_first"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:background="@drawable/bg_podium_highlight"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_podium_position_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ranking_posicion_1"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_podium_avatar_1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/cd_ranking_avatar"
                android:src="@drawable/ic_avatar_placeholder" />

            <TextView
                android:id="@+id/text_podium_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="PronosticoPro" />

            <TextView
                android:id="@+id/text_podium_points_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="3,420 pts" />

        </LinearLayout>

        <!-- Bloque 3.º puesto (derecha) -->
        <LinearLayout
            android:id="@+id/podium_third"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_podium_block"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_podium_position_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ranking_posicion_3"
                android:textColor="@color/text_gray"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_podium_avatar_3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/cd_ranking_avatar"
                android:src="@drawable/ic_avatar_placeholder" />

            <TextView
                android:id="@+id/text_podium_name_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                tools:text="BetMaster99" />

            <TextView
                android:id="@+id/text_podium_points_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/blue_end"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="2,610 pts" />

        </LinearLayout>

    </LinearLayout>

    <!-- Selector de periodo: Semanal (por defecto) / Mensual / Total -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_semanal"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/ranking_periodo_semanal"
            android:textColor="@color/text_white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_mensual"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ranking_periodo_mensual"
            android:textColor="@color/text_white" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_total"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ranking_periodo_total"
            android:textColor="@color/text_white" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Zona de contenido: lista + estados vacío/carga/error -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_ranking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            tools:listitem="@layout/item_match" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/ranking_vacio"
            android:textColor="@color/text_gray"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Contenedor de error con acción de reintentar -->
        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/ranking_error"
                android:textColor="@color/error_red"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_reintentar" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
