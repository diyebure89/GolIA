<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del bloque del 1.º puesto del podio (fragment_ranking.xml).
  Bloque destacado: relleno blue_dark con borde dorado (@color/gold) para
  resaltar al líder frente a los bloques 2.º/3.º (Requisitos 3.1, 3.2).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/blue_dark" />

    <corners android:radius="16dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/gold" />
</shape>
