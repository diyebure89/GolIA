<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo resaltado de la fila del Current_User en la lista de posiciones del
  Ranking (item_ranking.xml, tarea 8.2).

  Variante destacada de bg_match_card: mismo relleno oscuro con un borde y un
  tinte de acento (blue_end) para distinguir visualmente la entrada del usuario
  real (Requisito 2.5). El RankingAdapter aplica este fondo cuando
  Ranking_Entry.isCurrentUser() es true.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#1A00C6FF" />

    <corners android:radius="16dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/blue_end" />
</shape>
